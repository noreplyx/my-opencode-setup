{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "subagent_depth": 2,
  "lsp": true,
  "server": {
    "port": 4096
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest"
  ],
"provider": {
    "ollama-cloud": {
      "models": {
        "deepseek-v4-flash:0731-cloud": {
          "name": "DeepSeek V4 Flash 0731"
        }
      }
    }
  },

  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["bunx", "-y", "mcp-searxng"],
      "environment": {
        "SEARXNG_URL": "http://localhost:8080"
      },
      "enabled": true
    },
    "clickup": {
      "type": "remote",
      // "command": ["bunx", "-y", "mcp-remote", "https://mcp.clickup.com/mcp"],
      "url":"https://mcp.clickup.com/mcp",
      "enabled": true
    },
  }
}
