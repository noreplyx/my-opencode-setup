{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "subagent_depth": 3,
  "lsp": true,
  "server": {
    "port": 4096
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.6"
  ],
  "permission": {
    "clickup": "deny",
    // Keep the pre-approved surface inside the project. The workspace root is
    // already implicit, so no broad home/tree external_directory grants are
    // declared here: paths outside the project keep asking — except the
    // global explainer/handoff templates, which are read-only fallback sources.
    // NOTE: object order matters (last match wins): broad "*" first, narrow allows last.
    "external_directory": {
      "*": "ask",
      "/home/tanutchakorn/.config/opencode/docs/plans/**": "allow",
      "~/.config/opencode/docs/plans/**": "allow"
    }
  },
  "references": {
    "global-plans": {
      "path": "/home/tanutchakorn/.config/opencode/docs/plans",
      "description": "Global explainer + handoff templates fallback when project has no docs/plans templates"
    }
  },
  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["bunx", "-y", "mcp-searxng@2.1.0"],
      "environment": {
        "SEARXNG_URL": "http://localhost:8080"
      },
      "enabled": true
    },
    "clickup": {
      "type": "remote",
      // "command": ["bunx", "-y", "mcp-remote", "https://mcp.clickup.com/mcp"],
      "url":"https://mcp.clickup.com/mcp",
      "enabled": true
    },
    "aseprite": {
      "type": "local",
      "command": ["uv", "--directory", "/home/tanutchakorn/Codes/aseprite-mcp", "run", "-m", "aseprite_mcp"],
      "environment": {
        "ASEPRITE_PATH": "/home/tanutchakorn/.local/share/Steam/steamapps/common/Aseprite/aseprite"
      },
      "enabled": true
    }
  }
}
